[Unit]
Description=v3 ML model shadow performance tracker
After=network-online.target cb_recorder.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/phase3_intrabar
Environment=PYTHONUNBUFFERED=1
Environment=PHASE3_ARTIFACTS=/home/ec2-user/phase3_intrabar/artifacts
Environment=ML_V3_DIR=/home/ec2-user/phase3_intrabar/research/runner_research/v3_deploy
ExecStart=/home/ec2-user/phase3_intrabar/venv/bin/python -m research.runner_research.v3_shadow_tracker --days 7
StandardOutput=append:/home/ec2-user/phase3_intrabar/artifacts/v3_shadow_tracker.log
StandardError=append:/home/ec2-user/phase3_intrabar/artifacts/v3_shadow_tracker.log

[Install]
WantedBy=multi-user.target
