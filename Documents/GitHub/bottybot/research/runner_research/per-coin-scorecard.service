[Unit]
Description=Per-coin EV scorecard (rolling 7/14/30-day stats)
After=network-online.target cb_recorder.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/phase3_intrabar
Environment=PYTHONUNBUFFERED=1
Environment=PHASE3_ARTIFACTS=/home/ec2-user/phase3_intrabar/artifacts
ExecStart=/home/ec2-user/phase3_intrabar/venv/bin/python -m research.runner_research.per_coin_scorecard
StandardOutput=append:/home/ec2-user/phase3_intrabar/artifacts/per_coin_scorecard.log
StandardError=append:/home/ec2-user/phase3_intrabar/artifacts/per_coin_scorecard.log

[Install]
WantedBy=multi-user.target
