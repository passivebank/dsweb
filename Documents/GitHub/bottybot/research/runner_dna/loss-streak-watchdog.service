[Unit]
Description=Auto-swap champion on consecutive loss streak
After=network-online.target cb_recorder.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/phase3_intrabar
Environment=PYTHONUNBUFFERED=1
Environment=LIVE_FILTER_CONFIG=/home/ec2-user/phase3_intrabar/live_filter_config.json
Environment=LIVE_TRADES_PATH=/home/ec2-user/phase3_intrabar/artifacts/live_trades.jsonl
Environment=PROMOTION_LOG=/home/ec2-user/phase3_intrabar/artifacts/promotion_log.jsonl
Environment=LOSS_STREAK_THRESHOLD=3
Environment=BACKUP_CHAMPION=ml_runner_v1
Environment=BACKUP_HARD_STOP_PCT=0.015
Environment=ML_MODEL_DIR=/home/ec2-user/phase3_intrabar/research/runner_research/deploy
ExecStart=/home/ec2-user/phase3_intrabar/venv/bin/python -m research.runner_dna.loss_streak_watchdog
StandardOutput=append:/home/ec2-user/phase3_intrabar/artifacts/loss_streak_watchdog.log
StandardError=append:/home/ec2-user/phase3_intrabar/artifacts/loss_streak_watchdog.log

[Install]
WantedBy=multi-user.target
